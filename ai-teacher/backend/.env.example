# ==== Server ====
PORT=8080
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:5173

# ==== Auth ====
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ==== OpenAI (required - powers teaching, RAG embeddings, and voice) ====
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# ==== D-ID Avatar Video (optional - enables talking-head avatar video) ====
# If left blank, the app still works fully (chat teaching + AI voice audio +
# on-screen synced content). Avatar video generation will report itself as
# not configured instead of faking a video.
DID_API_KEY=
DID_AVATAR_IMAGE_URL=https://create-images-results.d-id.com/DefaultPresenters/Emma_f/image.jpeg

# ==== Storage ====
DATABASE_FILE=./data/ai_teacher.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
